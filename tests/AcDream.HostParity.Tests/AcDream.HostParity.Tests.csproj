<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Both hosts, so what each one declares can be compared in one place.
       Nothing here opens a window or a console session: the census reads
       standing declarations and reflects over the shared surface. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\AcDream.App\AcDream.App.csproj" />
    <ProjectReference Include="..\..\src\AcDream.Headless\AcDream.Headless.csproj" />
    <ProjectReference Include="..\..\src\AcDream.Runtime\AcDream.Runtime.csproj" />
    <ProjectReference Include="..\..\src\AcDream.Plugin.Abstractions\AcDream.Plugin.Abstractions.csproj" />
    <!-- The launcher writes the session document both clients read, so what
         it can put in one is part of what a launched session can be told. -->
    <ProjectReference Include="..\..\src\AcDream.Launcher.Core\AcDream.Launcher.Core.csproj" />
  </ItemGroup>
</Project>
