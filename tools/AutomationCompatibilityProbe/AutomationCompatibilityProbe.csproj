<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <RynthSuiteRoot Condition="'$(RynthSuiteRoot)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\..\refs\rynthify\RynthSuite'))</RynthSuiteRoot>
  </PropertyGroup>

  <Target Name="ValidateCompatibilityProbeInputs" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(RynthSuiteRoot)\Plugins\RynthCore.Plugin.RynthAi\Meta\MetFileParser.cs')"
           Text="RynthSuiteRoot does not identify the pinned source tree: $(RynthSuiteRoot)" />
  </Target>

  <ItemGroup>
    <AssemblyMetadata Include="RynthSuiteRoot" Value="$(RynthSuiteRoot)" />
    <ProjectReference Include="..\..\src\AcDream.Plugins.MossTank\AcDream.Plugins.MossTank.csproj" />
    <ProjectReference Include="$(RynthSuiteRoot)\Shared\RynthCore.LootSdk\RynthCore.LootSdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="$(RynthSuiteRoot)\Plugins\RynthCore.Plugin.RynthAi\LegacyUi\LegacyUiSettings.cs" Link="PinnedSource\LegacyUiSettings.cs" />
    <Compile Include="$(RynthSuiteRoot)\Plugins\RynthCore.Plugin.RynthAi\LegacyUi\NavRouteParser.cs" Link="PinnedSource\NavRouteParser.cs" />
    <Compile Include="$(RynthSuiteRoot)\Plugins\RynthCore.Plugin.RynthAi\Meta\LoadedMeta.cs" Link="PinnedSource\LoadedMeta.cs" />
    <Compile Include="$(RynthSuiteRoot)\Plugins\RynthCore.Plugin.RynthAi\Meta\MetaSchema.cs" Link="PinnedSource\MetaSchema.cs" />
    <Compile Include="$(RynthSuiteRoot)\Plugins\RynthCore.Plugin.RynthAi\Meta\MetFileParser.cs" Link="PinnedSource\MetFileParser.cs" />
    <Compile Include="$(RynthSuiteRoot)\Plugins\RynthCore.Plugin.RynthAi\Meta\AfFileParser.cs" Link="PinnedSource\AfFileParser.cs" />
    <Compile Include="$(RynthSuiteRoot)\Plugins\RynthCore.Plugin.RynthAi\Meta\AfFileWriter.cs" Link="PinnedSource\AfFileWriter.cs" />
  </ItemGroup>
</Project>
