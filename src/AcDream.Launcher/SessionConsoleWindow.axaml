<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AcDream.Launcher.ViewModels"
        x:Class="AcDream.Launcher.SessionConsoleWindow"
        x:DataType="vm:SessionConsoleViewModel"
        Title="{Binding Title}"
        Icon="avares://acdream-launcher/Assets/acdream-launcher.png"
        Width="860" Height="520" MinWidth="420" MinHeight="240"
        Background="#10171C">
  <Grid RowDefinitions="*,Auto,Auto" Margin="10" RowSpacing="8">
    <Border Grid.Row="0" Background="#0B1014" BorderBrush="#35434B" BorderThickness="1" CornerRadius="3">
      <ScrollViewer x:Name="OutputScroll"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto"
                    Padding="8,6">
        <SelectableTextBlock x:Name="OutputText"
                             TextWrapping="NoWrap"
                             FontFamily="Cascadia Mono,Consolas,Menlo,DejaVu Sans Mono,monospace"
                             FontSize="12"
                             Foreground="#C8D2D8"
                             AutomationProperties.Name="Session output" />
      </ScrollViewer>
    </Border>
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
      <TextBox x:Name="InputBox"
               Text="{Binding Input, Mode=TwoWay}"
               PlaceholderText="Type a command or chat line, then press Enter  (for example /vt start, /quit)"
               FontFamily="Cascadia Mono,Consolas,Menlo,DejaVu Sans Mono,monospace"
               FontSize="12"
               KeyDown="OnInputKeyDown"
               AutomationProperties.Name="Console input" />
      <Button Grid.Column="1" Content="Send" Command="{Binding SendCommand}" />
    </Grid>
    <TextBlock Grid.Row="2" Text="{Binding Notice}" Foreground="#FFB0A0" FontSize="12"
               IsVisible="{Binding Notice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
  </Grid>
</Window>
