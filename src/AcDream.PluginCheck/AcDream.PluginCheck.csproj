<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>acdream-plugincheck</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AcDream.PluginCheck.Tests" />
    <!-- The bundled example plugin's manifest is checked with this tool's own runner, beside
         the client's and the launcher's readers, in the windowless host's suite. -->
    <InternalsVisibleTo Include="AcDream.Headless.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AcDream.Launcher.Core\AcDream.Launcher.Core.csproj" />
  </ItemGroup>
</Project>
