<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>acdream-headless</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- A windowless bot has no frames to protect, so its garbage collector
         is set to hand memory back rather than keep it for speed: no
         background collection thread, a small allowance for new objects
         (runtimeconfig.template.json), and compaction whenever the heap is
         mostly free space. Measured on a looting bot: about 40% less private
         memory for about half a point of one core. The windowed client keeps
         the defaults, where a longer collection would show as a stutter. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AcDream.Headless.Tests" />
    <InternalsVisibleTo Include="AcDream.HostParity.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AcDream.Runtime\AcDream.Runtime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Says this host knows the single install folder; the launcher refuses
         to start a client folder without it. Only the client and windowless
         host carry it: the launcher checks the client's folder, not its own,
         and a stray file in the macOS app bundle's code folder breaks its
         signature. -->
    <None Include="..\AcDream.Platform\single-install-root.capability"
          Link="single-install-root.capability"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
